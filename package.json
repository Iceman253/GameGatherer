{
  "name": "gamegatherer",
  "version": "1.0.0",
  "description": "Unified game library aggregator for Steam, Epic, and EA",
  "main": "./out/main/index.js",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "preview": "electron-vite preview",
    "dist": "electron-vite build && electron-builder"
  },
  "dependencies": {
    "@types/dompurify": "^3.0.5",
    "dompurify": "^3.3.3",
    "marked": "^17.0.5"
  },
  "devDependencies": {
    "@electron-toolkit/preload": "^3.0.1",
    "@electron-toolkit/utils": "^3.0.0",
    "@types/node": "^20.14.0",
    "@types/react": "^18.3.3",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.3.1",
    "autoprefixer": "^10.4.19",
    "electron": "^35.7.5",
    "electron-builder": "^26.8.1",
    "electron-vite": "^3.1.0",
    "postcss": "^8.4.39",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-vanilla-tilt": "^1.0.0",
    "tailwindcss": "^3.4.6",
    "typescript": "^5.5.3",
    "vite": "^6.2.0",
    "zustand": "^4.5.4"
  },
  "build": {
    "appId": "com.gamegatherer.app",
    "productName": "GameGatherer",
    "win": {
      "target": "nsis",
      "icon": "resources/icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    },
    "files": [
      "out/**/*"
    ],
    "directories": {
      "buildResources": "resources",
      "output": "dist"
    }
  }
}
